# Copy to .env and fill in. Use letters, digits, - and _ only in passwords.

# Database admin/owner (apptracker): schema, migrations, configuration.
POSTGRES_PASSWORD=change-me-admin

# Limited users: the collector (app_collector) and the backend (app_backend).
COLLECTOR_PASSWORD=change-me-collector
BACKEND_PASSWORD=change-me-backend

# Header X-Admin-Key for /api/admin/** (rebuild events, run lookups now). Empty = disabled.
ADMIN_KEY=change-me-admin-key

# Sent to Apple with every request.
USER_AGENT=app-tracker/1.0 (contact: you@example.com)

# Web app origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173
