# Settings for docker compose. Copy to .env, fill in, then: chmod 600 .env
# Values with $ or other symbols: put them in single quotes, e.g. PASSWORD='a$b'.
# See DEPLOY.md.

# ---------------------------------------------------------------- database
# Collector login, as a URL: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Symbols in the password must be URL-encoded (@ -> %40, : -> %3A, / -> %2F, # -> %23).
COLLECTOR_DATABASE_URL=postgres://app_collector:change-me-collector@db-host:5432/apptracker

# Backend login (JDBC URL without the password; the password goes as is, no encoding).
BACKEND_JDBC_URL=jdbc:postgresql://db-host:5432/apptracker
BACKEND_DB_USER=app_backend
BACKEND_DB_PASSWORD=change-me-backend

# Only with "--profile local-db" (a new PostgreSQL in Docker). Then use host
# "postgres" and database "apptracker" above, and the same two passwords.
# Letters, digits, - and _ only.
POSTGRES_PASSWORD=
COLLECTOR_PASSWORD=
BACKEND_PASSWORD=

# ---------------------------------------------------------------- backend
# Header X-Admin-Key for the Settings menu (/api/manage/**) and /api/admin/**.
# Empty = open to anyone who can reach the site. Set it before the site is public:
#   openssl rand -hex 24
ADMIN_KEY=

# Web app origins allowed to call the API directly (comma-separated). Not needed
# when the web app and the API share one address (the default setup).
CORS_ORIGINS=http://localhost:5173

# Java options for the backend (memory).
BACKEND_JAVA_OPTS=-Xmx512m

# ---------------------------------------------------------------- shared
# Sent to Apple with every request (collector and backend).
USER_AGENT=app-tracker/1.0 (contact: you@example.com)

# ---------------------------------------------------------------- web app
# Ports on the server (check they are free: sudo ss -ltnp | grep -E ':(8082|3003) ').
# The web app:
#   127.0.0.1:3003  only on the server, behind a reverse proxy with HTTPS (Caddy, see DEPLOY.md)
#   3003            open on the internet: http://SERVER-IP:3003 (plain HTTP)
FRONTEND_BIND=127.0.0.1:3003
# The backend API, for checks on the server itself (the web app does not need it).
BACKEND_BIND=127.0.0.1:8082
