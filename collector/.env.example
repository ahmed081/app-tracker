# Copy to .env and fill in.
POSTGRES_PASSWORD=change-me
USER_AGENT=app-tracker-collector/1.0 (contact: you@example.com)

# Used when running with `node` directly instead of Docker:
DATABASE_URL=postgres://apptracker:change-me@localhost:5432/apptracker

# Optional tuning (defaults shown)
# HTTP_TIMEOUT_MS=20000
# HTTP_RETRY_DELAYS_MS=10000,30000,60000
# HTTP_MIN_INTERVAL_MS=1000
# SCHEDULER_TICK_MS=60000
# JITTER_MAX_SECONDS=60
# RETRY_AFTER_MINUTES=5
# GENRE_SYNC_DAYS=7
# MIN_ENTRIES=25
